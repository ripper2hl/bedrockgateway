{
  "name": "bedrockgateway",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node index",
    "debug": "DEBUG=minecraft-protocol* node index",
    "dev": "DEBUG=minecraft-protocol* nodemon index",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch --forceExit --detectOpenHandles",
    "test:coverage": "jest --coverage --forceExit --detectOpenHandles"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "database/**/*.js",
      "proxy/dummyPackets.js",
      "api/**/*.js"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bedrock-protocol": "3.57.0",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.6",
    "dns2": "^2.1.0",
    "dockerode": "^5.0.1",
    "express": "^5.2.1",
    "minecraft-data": "3.111.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
